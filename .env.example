NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — server-only, NEVER prefix with NEXT_PUBLIC_.
# Used by the notification emit helpers (DP-024) to insert rows into
# `notifications` on behalf of another user. Found in the Supabase
# dashboard under Settings → API → Project API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Salary encryption key (32 bytes / 64 hex chars). Server-only — NEVER prefix with NEXT_PUBLIC_.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SALARY_ENCRYPTION_KEY=

# Site URL for auth callbacks (set to your production URL in Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key — server-only, NEVER prefix with NEXT_PUBLIC_.
# When unset, src/lib/email.ts short-circuits to "test_mode": templates
# still render (so template bugs are caught in CI / preview) but no
# network call is made. Fill this in only in production, or in a
# preview where you want real sends.
RESEND_API_KEY=

# From address for transactional email. Optional — defaults to
# "Giving Tracker <onboarding@resend.dev>" (Resend's sandbox sender),
# which is fine for dev. In production, set this to a verified sender
# on a domain you've configured in Resend.
RESEND_FROM=

# Every.org public API key (pk_live_*). Used server-side by
# src/lib/every-org.ts for nonprofit search and slug lookup. Issued in
# the Every.org partner dashboard. Safe to expose per Every.org's
# design, but we keep it server-side so we can swap providers or add
# a per-origin rate-limiting proxy later.
EVERY_ORG_PUBLIC_KEY=
